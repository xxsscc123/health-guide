        "浓茶、咖啡"
      ],
      "recipes": [
        {
          "name": "黄芪炖鸡汤",
          "ingredients": ["黄芪30g", "鸡肉500g", "红枣5颗", "生姜3片"],
          "method": "1. 鸡肉洗净切块，焯水去血沫\n2. 黄芪、红枣洗净\n3. 所有材料放入炖盅，加水\n4. 大火煮沸后转小火炖2小时\n5. 加盐调味即可",
          "effect": "补气健脾，增强体质",
          "frequency": "每周2-3次"
        },
        {
          "name": "山药粥",
          "ingredients": ["山药100g", "大米100g", "红枣5颗"],
          "method": "1. 山药去皮切块\n2. 大米、红枣洗净\n3. 一起放入锅中加水煮粥\n4. 煮至软烂即可",
          "effect": "健脾益气，养胃",
          "frequency": "可每天早餐食用"
        },
        {
          "name": "党参红枣茶",
          "ingredients": ["党参15g", "红枣5颗", "枸杞10g"],
          "method": "1. 所有材料洗净\n2. 放入杯中用开水冲泡\n3. 焖10分钟后饮用",
          "effect": "补气养血",
          "frequency": "每天1-2次"
        }
      ],
      "tips": [
